# ---- Spotify Web API（推奨。無いと Mac の Spotify アプリ + AppleScript のみで動作）----
# https://developer.spotify.com/dashboard でアプリを作り、Client ID を入れる
# Redirect URI に http://127.0.0.1:8080/callback を登録する（Client Secret は不要）
SPOTIFY_CLIENT_ID=

# ---- 任意: Last.fm（最近聴いた曲・今日/7日/今月の再生数・ジャンルの根拠タグ）----
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USER=

# ---- 任意: Gemini（Genre / Mood のレビュー）----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- 任意: Genius（LRCLIB に無い曲の歌詞のフォールバック）----
# https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# ---- 任意: ポート・待ち受け設定 ----
# PORT=3000
# AUTH_PORT=8080
# HOST=127.0.0.1   # このマシンからだけ使う場合。スマホ等から見るなら未設定のまま
